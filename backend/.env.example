# ==============================================================================
# TRANSPORT GPS TRACKING SYSTEM - BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env in backend/ and configure with your production credentials.
# NEVER commit your actual .env file or production secrets to Git.

# --- 1. Application Environment ---
# Options: production | development | testing
APP_ENV=production
PORT=5000

# --- 2. Security & Encryption Keys ---
# Generate a cryptographically secure random string (minimum 32 characters)
# Example generation command: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-secret-key-min-32-chars

# --- 3. JWT Authentication ---
# Secret key used for signing JSON Web Tokens (minimum 32 characters)
JWT_SECRET_KEY=replace-with-a-strong-jwt-secret-key-min-32-chars
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# --- 4. Database (Supabase PostgreSQL) ---
# Supabase connection URI format with psycopg2 driver:
# Direct: postgresql+psycopg2://postgres:<YOUR_DB_PASSWORD>@db.<YOUR_PROJECT_REF>.supabase.co:5432/postgres
# Pooler (Session/Transaction): postgresql+psycopg2://postgres.<YOUR_PROJECT_REF>:<YOUR_DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+psycopg2://postgres:<YOUR_DB_PASSWORD>@db.<YOUR_PROJECT_REF>.supabase.co:5432/postgres

# Database connection pool tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- 5. CORS Configuration ---
# Comma-separated list of allowed frontend origins (deployed Vercel domain and optional local dev)
# Example: https://<YOUR_FRONTEND_APP>.vercel.app,http://localhost:3000
CORS_ORIGINS=https://<YOUR_FRONTEND_APP>.vercel.app

# --- 6. GPS Fleet Simulation & Safety Settings ---
# GPS Demo Mode: MUST BE 'false' in production. Only enable 'true' in development/testing.
GPS_DEMO_MODE=false

# Inactivity timeout (seconds) before an un-pinged vehicle is marked 'offline' (default 600s = 10m)
GPS_OFFLINE_TIMEOUT_SECONDS=600

# Stop detection: minimum stationary duration in seconds to create a discrete stop record (default 120s = 2m)
STOP_MINIMUM_DURATION_SECONDS=120

# Stop clustering radius in meters (default 50.0m)
STOP_RADIUS_METERS=50.0

# Stop detection maximum speed threshold in km/h (default 3.0 km/h)
STOP_MAX_SPEED_KMH=3.0

# Default fleet speed limit in km/h (triggers overspeed alert when exceeded)
DEFAULT_SPEED_LIMIT_KMH=80.0

# --- 7. Report & Audit Log Retention ---
# Number of hours to retain generated report export logs (default 168h = 7 days)
REPORT_RETENTION_HOURS=168
